# Copy to .env. Never commit .env.

# Meta Model API (hackathon credits). Create a key at https://dev.meta.ai -> API keys.
MODEL_API_KEY=
# USD per 1M tokens for the cost log; fill in from the Meta billing page.
WORKLENS_PRICE_IN=0
WORKLENS_PRICE_OUT=0

# Fallback: OpenRouter serving the same model. Used when MODEL_API_KEY is empty,
# or when WORKLENS_LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# WORKLENS_LLM_PROVIDER=meta

# Overrides (rarely needed)
# WORKLENS_LLM_BASE_URL=https://api.meta.ai/v1
# WORKLENS_LLM_MODEL=muse-spark-1.3
# WORKLENS_REASONING_EFFORT=low
