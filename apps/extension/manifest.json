{
  "manifest_version": 3,
  "name": "WorkLens Recorder",
  "version": "0.1.0",
  "description": "Record a task from your browser and send it straight to WorkLens, with role and process set. Tab switches are logged so each step is tied to the right application.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "WorkLens Recorder" },
  "background": { "service_worker": "background.js" },
  "permissions": ["desktopCapture", "offscreen", "tabs", "storage"],
  "host_permissions": ["https://worklens-iota.vercel.app/*", "https://*.supabase.co/*", "http://localhost:3000/*"],
  "commands": {
    "toggle-recording": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Start or stop recording" }
  }
}
