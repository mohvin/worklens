# Dev only: where the local worker writes runs (runs/<id>/run.json). Default: ../../runs from apps/web.
WORKLENS_RUNS_DIR=../../runs

# Hosted uploads (optional; without these the site serves the replay sample only). See docs/deploy.md.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WORKLENS_WORKER_URL=
WORKLENS_WORKER_SECRET=
