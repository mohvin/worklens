<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_synthetic-invoice" targetNamespace="https://worklens.purplelab.ai/bpmn" exporter="WorkLens" exporterVersion="0.1">
  <bpmn:process id="worklens_synthetic-invoice" name="synthetic-invoice.mp4" isExecutable="false">
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="n1" name="Mail: select invoice email (9 s, 2x)">
      <bpmn:documentation>2 visit(s), 9.0 s total, 9% of the recording. Object: INV-20481</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n2" name="Mail: open attachment (6 s)">
      <bpmn:documentation>1 visit(s), 6.0 s total, 6% of the recording. Object: invoice-20481.pdf</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n3" name="PDF Viewer: read invoice PDF (8 s)">
      <bpmn:documentation>1 visit(s), 8.0 s total, 8% of the recording. Object: INV-20481</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n4" name="ERP - Accounts Payable: wait for invoice form (21 s)">
      <bpmn:documentation>1 visit(s), 21.0 s total, 22% of the recording. Object: invoice form</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n5" name="ERP - Accounts Payable: fill invoice form (17 s)">
      <bpmn:documentation>1 visit(s), 17.0 s total, 18% of the recording. Object: INV-20481</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n6" name="Sheets: check PO in register (9 s)">
      <bpmn:documentation>1 visit(s), 9.0 s total, 9% of the recording. Object: PO-7731</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n7" name="ERP - Accounts Payable: fill invoice form and submit (13 s)">
      <bpmn:documentation>1 visit(s), 13.0 s total, 14% of the recording. Object: INV-20481</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n8" name="Mail: click Reply (2 s)">
      <bpmn:documentation>1 visit(s), 2.0 s total, 2% of the recording. Object: INV-20481</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n9" name="Mail: send approval reply (6 s)">
      <bpmn:documentation>1 visit(s), 6.0 s total, 6% of the recording. Object: Invoice INV-20481</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="n10" name="Mail: view approval confirmation (4 s)">
      <bpmn:documentation>1 visit(s), 4.0 s total, 4% of the recording. Object: Invoice INV-20481</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="end" name="End" />
    <bpmn:sequenceFlow id="flow_start" sourceRef="start" targetRef="n1" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="n1" targetRef="n2" />
